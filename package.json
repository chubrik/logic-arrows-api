{
  "name": "logic-arrows-api",
  "version": "0.2.0",
  "description": "TypeScript declarations and constants for the script block API of Logic Arrows",
  "keywords": [
    "logic-arrows",
    "script-block",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "author": "Arkadi Chubrik <arkadi@chubrik.org>",
  "homepage": "https://github.com/chubrik/logic-arrows-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chubrik/logic-arrows-api.git"
  },
  "bugs": {
    "url": "https://github.com/chubrik/logic-arrows-api/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "script-api.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
